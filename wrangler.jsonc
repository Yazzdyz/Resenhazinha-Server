{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resenhazinha-server",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ResenhazinhaRoom"
      }
    ]
  },
  "exports": {
    "ResenhazinhaRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
